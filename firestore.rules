
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Helper to check if the authenticated user is the student owner of the path
    function isStudentOwner(regId) {
      return isSignedIn() && (
        get(/databases/$(database)/documents/student/$(regId)).data.email == request.auth.token.email
      );
    }

    match /student/{regId} {
      // Allow user to get their own profile or admin to list/get
      allow get: if isSignedIn() && (isAdmin() || (exists(/databases/$(database)/documents/student/$(regId)) && get(/databases/$(database)/documents/student/$(regId)).data.email == request.auth.token.email));
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();

      // Student Reports for Admin review
      match /report/{reportId} {
        allow get, list: if isSignedIn() && (isStudentOwner(regId) || isAdmin());
        allow create: if isSignedIn() && isStudentOwner(regId);
        allow delete: if isAdmin();
      }

      match /progress/{paperId} {
        allow get, list: if isSignedIn() && (isStudentOwner(regId) || isAdmin());
        allow create, update: if isSignedIn() && isStudentOwner(regId);
        allow delete: if isAdmin();
        
        match /history/{historyId} {
           allow get, list: if isSignedIn() && (isStudentOwner(regId) || isAdmin());
           allow create: if isSignedIn() && isStudentOwner(regId);
        }
      }
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && (isAdmin() || request.resource.data.email == "sunilsingh8896@gmail.com");
      allow update, delete: if isAdmin();
    }

    match /userSessions/{sessionId} {
      allow get, update: if isSignedIn() && (request.auth.uid == sessionId || isAdmin());
      allow create: if isSignedIn();
      allow list, delete: if isAdmin();
    }

    match /papers/{paperId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
