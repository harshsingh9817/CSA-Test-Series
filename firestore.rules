
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == "sunilsingh8896@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    
    function isStudentOwner(regId) {
      return isSignedIn() && (
        request.auth.token.email.lower() == (regId.lower() + "@csa.com")
      );
    }

    match /student/{regId} {
      // Allow any signed-in user to 'get' for password verification during login
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();

      match /report/{reportId} {
        allow get, list: if isSignedIn() && (isStudentOwner(regId) || isAdmin());
        allow create: if isSignedIn() && isStudentOwner(regId);
        allow delete: if isAdmin();
      }

      match /progress/{paperId} {
        allow get, list: if isSignedIn() && (isStudentOwner(regId) || isAdmin());
        allow create, update: if isSignedIn() && isStudentOwner(regId);
        allow delete: if isAdmin();
        
        match /history/{historyId} {
           allow get, list: if isSignedIn() && (isStudentOwner(regId) || isAdmin());
           allow create: if isSignedIn() && isStudentOwner(regId);
        }
      }
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && (isAdmin() || request.resource.data.email.lower() == "sunilsingh8896@gmail.com");
      allow update, delete: if isAdmin();
    }

    match /userSessions/{sessionId} {
      allow get, update: if isSignedIn() && (request.auth.uid == sessionId || isAdmin());
      allow create: if isSignedIn();
      allow list, delete: if isAdmin();
    }

    match /papers/{paperId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
